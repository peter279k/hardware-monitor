# 連線目標。MQTT_HOST 要對應伺服器憑證的 CN,否則主機名驗證會失敗
MQTT_HOST=rabbitmq.local
MQTT_USER=gwpub
MQTT_PASS=YOUR_PASSWORD
MQTT_TOPIC_PREFIX=/3e_green_sensor

# ── TLS(憑證路徑全部參數化)──────────────
MQTT_TLS_ENABLED=true
# 未指定 MQTT_PORT 時,TLS 開啟會自動用 8883;要覆寫再取消下一行註解
# MQTT_PORT=8883

# 驗證 broker 用的 CA 憑證(自簽時必填;用公開 CA 簽發可留空走系統 CA)
MQTT_CA_CERT=/home/pi/green-gateway/certs/ca_cert.pem

# 雙向認證 (mTLS) 才需要;單向 TLS 時兩者都留空
# MQTT_CLIENT_CERT=/home/pi/green-gateway/certs/client_cert.pem
# MQTT_CLIENT_KEY=/home/pi/green-gateway/certs/client_key.pem
# MQTT_CLIENT_KEY_PASS=

# 僅供測試:設 true 會停用主機名驗證,正式環境務必保持 false
MQTT_TLS_INSECURE=false

# ── 資料庫與其他 ──────────────────────────
GW_DB_PATH=/home/pi/green-gateway/sensor_data.db
GW_LOG_PATH=/home/pi/green-gateway/mqtt_publisher.log
GW_PURGE_STALE=false
